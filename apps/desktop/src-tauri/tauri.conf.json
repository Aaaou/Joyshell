{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joyshell",
  "version": "0.1.42",
  "identifier": "dev.joyshell.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Joyshell",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 720,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/windows/openssl/*.dll": "resources/windows/openssl/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/openssl-dlls.nsh"
      }
    },
    "shortDescription": "Cross-platform SSH workspace with guarded assistants",
    "longDescription": "Joyshell is a cross-platform SSH workspace with terminal, SFTP, themes, and a guarded assistant system."
  }
}
